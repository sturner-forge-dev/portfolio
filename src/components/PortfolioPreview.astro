---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
	loading?: 'eager' | 'lazy';
}

const { data, id } = Astro.props.project;
const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a class="card" href={`${BASE_PATH}/work/${id}`}>
	<span class="title">{data.title}</span>
	<Image src={data.img} alt={data.img_alt || ''} width={480} height={480} loading={Astro.props.loading || 'eager'} />
</a>

<style>
	.card {
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		height: 14rem;
		background: var(--gradient-subtle);
		border: 3px solid var(--gray-100);
		border-radius: 1.25rem;
		overflow: hidden;
		box-shadow:
			10px 10px 0 var(--accent-light),
			var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 800;
		transition:
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	.card:hover {
		box-shadow:
			14px 14px 0 var(--accent-regular),
			var(--shadow-md);
		transform: translate(-3px, -3px) rotate(-0.5deg);
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 1;
		margin: 0.75rem;
		padding: 0.5rem 1rem;
		background: var(--accent-pop, #d8ff3d);
		color: #18130b;
		border: 2px solid var(--gray-100);
		border-radius: 999rem;
		box-shadow: 4px 4px 0 var(--gray-100);
	}

	img {
		grid-area: 1 / 1 / 3 / 3;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 50em) {
		.card {
			height: 24rem;
			border-radius: 2rem;
		}

		.title {
			border-radius: 0.9375rem;
		}
	}
</style>
