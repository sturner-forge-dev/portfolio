---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside>
	<h2>Interested in working together?</h2>
	<CallToAction href="mailto:steven.turner12x@gmail.com">
		Send Me a Message
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 3px solid var(--gray-100);
		border-bottom: 3px solid var(--gray-100);
		padding: 5rem 1.5rem;
		background:
			linear-gradient(135deg, rgba(255, 77, 141, 0.18), transparent 45%),
			linear-gradient(315deg, rgba(0, 194, 255, 0.18), transparent 45%), var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 15ch;
		letter-spacing: -0.06em;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}
	}
</style>
