---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
	size?: 'default' | 'display';
	showEyebrow?: boolean;
}

const { align = 'center', showEyebrow = false, size = 'default', tagline, title } = Astro.props;
---

<div class:list={['hero stack gap-4', align, size]}>
	{showEyebrow && <p class="eyebrow">Builder. Debugger. Occasional chaos wrangler.</p>}
	<div class="stack gap-2">
		<h1 class="title">{title}</h1>
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
		position: relative;
		justify-content: center;
		min-height: 10rem;
		padding: 0.25rem 0.5rem 0.4rem;
	}

	.display {
		min-height: 0;
	}

	.eyebrow {
		width: fit-content;
		max-width: min(100%, calc(100vw - 4rem));
		margin-inline: auto;
		padding: 0.45rem 0.8rem;
		border: 2px solid var(--gray-100);
		border-radius: 999rem;
		background: var(--accent-pop, #d8ff3d);
		color: #18130b;
		font-family: var(--font-brand);
		font-size: clamp(0.7rem, 2.7vw, var(--text-sm));
		font-weight: 800;
		letter-spacing: 0.02em;
		text-align: center;
		box-shadow: 4px 4px 0 var(--gray-100);
		transform: rotate(-1deg);
	}

	.title,
	.tagline {
		max-width: 37ch;
		margin-inline: auto;
	}

	.title {
		font-size: clamp(2.2rem, 10vw, var(--text-3xl));
		color: var(--gray-0);
		letter-spacing: -0.08em;
		text-wrap: balance;
		overflow-wrap: anywhere;
		text-shadow: 0.055em 0.055em 0 var(--accent-regular);
	}

	.tagline {
		color: var(--gray-200);
		font-weight: 700;
		font-size: clamp(1rem, 4.2vw, var(--text-lg));
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
			padding: 0;
		}

		.start {
			text-align: start;
		}

		.start .eyebrow {
			margin-inline: unset;
		}

		.start .title,
		.start .tagline {
			margin-inline: unset;
		}

		.title {
			font-size: clamp(3.5rem, 7vw, 5.75rem);
		}

		.display .title {
			font-size: clamp(4.5rem, 11vw, 8.75rem);
		}
	}
</style>
