---
interface Props {
	wrap?: boolean;
}

const { wrap = false } = Astro.props;
---

<div class:list={['pill', { wrap }]}><slot /></div>

<style>
	.pill {
		display: flex;
		padding: 0.42rem 0.78rem;
		gap: 0.5rem;
		align-items: center;
		color: var(--gray-0);
		border: 2px solid var(--gray-100);
		background: var(--gray-999);
		border-radius: 999rem;
		font-size: var(--text-sm);
		font-weight: 800;
		line-height: 1.35;
		white-space: nowrap;
		box-shadow: 4px 4px 0 var(--accent-light);
		transform: rotate(-1deg);
	}

	.pill:nth-child(even) {
		box-shadow: 4px 4px 0 var(--accent-regular);
		transform: rotate(1deg);
	}

	.wrap {
		justify-content: center;
		min-width: 0;
		width: 100%;
		white-space: normal;
		text-align: center;
	}

	@media (min-width: 50em) {
		.pill {
			padding: 0.5rem 1rem;
			font-size: var(--text-md);
		}

		.wrap {
			width: auto;
			white-space: nowrap;
			text-align: left;
		}
	}
</style>
