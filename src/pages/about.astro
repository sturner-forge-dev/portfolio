---
import { Image } from 'astro:assets';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="About | Steven Turner" description="About Steven Turner">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero title="About" tagline="Thanks for stopping by. Read below to learn more about myself and my background.">
				<Image
					width="1035"
					height="582"
					src={`${BASE_PATH}/assets/with-kids.jpg`}
					alt="Steven Turner and girlfriend with nieces"
					priority
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I am a Senior Software Developer and Team Lead with 6 years of professional experience, primarily focused on
						the financial technology (Fintech) industry. Throughout my career, I have specialized in building robust
						internal tools for complex operations, particularly in the domain of loan processing.
					</p>
					<p>
						My technical expertise spans across various modern and established technologies, including front-end
						frameworks like React, Angular, and Vue, and full-stack development with PHP and Laravel. As a senior-level
						team lead, I combine technical mastery with leadership, actively mentoring junior and mid-level developers
						to foster a strong, collaborative engineering culture.
					</p>
					<p>
						I currently live in beautiful Denver, Colorado with my girlfriend and our 11 year old Australian Cattle Dog.
						In my free time, I enjoy hiking, exploring the outdoors, breaking my Linux config (Arch BTW) and spending
						quality time with my friends and family.
					</p>
				</div>
				<section>
					<h2 class="section-title">Education</h2>
					<div class="content">
						<p>Texas State University, 2020</p>
					</div>
				</section>
				<section>
					<h2 class="section-title">Skills</h2>
					<div class="content">
						<ul class="list">
							<li>
								<strong>Languages:</strong> PHP, JavaScript/TypeScript, SQL, Bash
							</li>
							<li>
								<strong>Frontend:</strong> React, Angular, Tailwind CSS
							</li>
							<li>
								<strong>Backend:</strong> Laravel, Node.js, REST APIs
							</li>
							<li>
								<strong>Databases:</strong> MySQL, PostgreSQL
							</li>
							<li>
								<strong>DevOps/Tools:</strong> Docker, Git, Sentry, CI/CD, JIRA
							</li>
							<li>
								<strong>Concepts:</strong> System Architecture, Mentorship, Agile/Scrum, UI/UX
							</li>
						</ul>
					</div>
				</section>
			</section>

			<ContactCTA />
		</main>
	</div>

	<style>
		.about {
			display: flex;
			flex-direction: column;
			gap: 3.5rem;
			max-width: 52rem;
			margin-inline: auto;
		}

		img {
			display: block;
			width: 100%;
			aspect-ratio: 16 / 9;
			object-fit: cover;
			margin-top: 1.5rem;
			border: 3px solid var(--gray-100);
			border-radius: 2rem;
			box-shadow:
				12px 12px 0 var(--accent-regular),
				var(--shadow-md);
		}

		section {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			color: var(--gray-200);
		}

		.section-title {
			grid-column-start: 1;
			font-size: var(--text-xl);
			color: var(--gray-0);
		}

		.content {
			grid-column: 2 / 4;
		}

		.content :global(a) {
			text-decoration: 1px solid underline transparent;
			text-underline-offset: 0.25em;
			transition: text-decoration-color var(--theme-transition);
		}

		.content :global(a:hover),
		.content :global(a:focus) {
			text-decoration-color: currentColor;
		}

		.list {
			padding-inline-start: 15px;
		}

		@media (min-width: 50em) {
			section {
				display: grid;
				grid-template-columns: 11rem minmax(0, 1fr);
				gap: 1rem 2.5rem;
				font-size: var(--text-lg);
			}

			section section {
				grid-column: 1 / -1;
			}
		}
	</style>
</BaseLayout>
