---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
// Component Imports
import CallToAction from '../components/CallToAction.astro';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero title="Steven Turner" tagline="Senior Software Engineer" align="start" size="display" showEyebrow>
					<div class="roles">
						<Pill><Icon icon="typescript-logo" size="1.33em" /> TypeScript</Pill>
						<Pill><Icon icon="react-logo" size="1.33em" />React</Pill>
						<Pill><Icon icon="backend" size="1.33em" />PHP</Pill>
						<Pill><Icon icon="framework" size="1.33em" />Laravel</Pill>
					</div>
				</Hero>

				<Image
					alt="Steven Turner smiling with eclipse glasses"
					width="480"
					height="620"
					src={`${BASE_PATH}/assets/selfie.jpg`}
					priority
				/>
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Selected Work</h3>
					<p>Take a look below at my most recent work experience.</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} loading="lazy" />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href={`${BASE_PATH}/work/`}>
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: grid;
		align-items: center;
		gap: 1.75rem;
		position: relative;
		padding: 0;
		overflow: clip;
	}

	.hero::before {
		display: none;
	}

	.roles {
		display: none;
	}

	.hero img {
		display: block;
		width: calc(100% - 0.75rem);
		max-width: 28rem;
		justify-self: center;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: center 28%;
		border: 4px solid var(--gray-100);
		border-radius: 1.5rem;
		box-shadow:
			6px 6px 0 var(--accent-regular),
			var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: minmax(0, 1.12fr) minmax(18rem, 0.68fr);
			padding-inline: 2.5rem;
			gap: 4.5rem;
			min-height: 26rem;
			overflow: visible;
		}

		.hero::before {
			inset: 7% -6% auto auto;
			width: min(18rem, 42vw);
			box-shadow: 12px 12px 0 var(--accent-regular);
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			min-height: 0;
			border-radius: 35% 65% 54% 46% / 48% 38% 62% 52%;
			object-fit: cover;
			box-shadow:
				12px 12px 0 var(--accent-regular),
				var(--shadow-md);
			transform: rotate(1.5deg);
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.section-header {
		justify-self: start;
		text-align: left;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-200);
	}

	.section-header h3 {
		font-size: clamp(var(--text-2xl), 8vw, var(--text-4xl));
		letter-spacing: -0.06em;
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
