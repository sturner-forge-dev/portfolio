---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<Footer />
		</div>

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>

		<style>
			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				background:
					linear-gradient(90deg, rgba(24, 19, 11, 0.05) 1px, transparent 1px) 0 0 / 4rem 4rem,
					linear-gradient(rgba(24, 19, 11, 0.05) 1px, transparent 1px) 0 0 / 4rem 4rem,
					radial-gradient(circle at 16% 12%, rgba(255, 77, 141, 0.22), transparent 18rem),
					radial-gradient(circle at 86% 10%, rgba(216, 255, 61, 0.22), transparent 16rem),
					radial-gradient(circle at 70% 70%, rgba(0, 194, 255, 0.16), transparent 22rem),
					var(--gray-999);
			}
			:root.theme-dark .backgrounds {
				background:
					linear-gradient(90deg, rgba(255, 249, 232, 0.06) 1px, transparent 1px) 0 0 / 4rem 4rem,
					linear-gradient(rgba(255, 249, 232, 0.06) 1px, transparent 1px) 0 0 / 4rem 4rem,
					radial-gradient(circle at 16% 12%, rgba(255, 77, 141, 0.28), transparent 18rem),
					radial-gradient(circle at 86% 10%, rgba(216, 255, 61, 0.16), transparent 16rem),
					radial-gradient(circle at 70% 70%, rgba(0, 194, 255, 0.18), transparent 22rem),
					var(--gray-999);
			}
			@media (forced-colors: active) {
				/* Deactivate custom backgrounds for high contrast users. */
				.backgrounds {
					background: none;
					background-blend-mode: none;
					--bg-gradient-size: none;
				}
			}
		</style>
	</body>
</html>
